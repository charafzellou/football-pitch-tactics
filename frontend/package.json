{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port 8080 --no-fork",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "db:setup": "bun run db:migrate && bun run db:push && bun run db:seed",
    "db:migrate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run server/db/seed.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.61",
    "@iconify-json/simple-icons": "^1.2.46",
    "@libsql/client": "^0.15.10",
    "@nuxt/ui": "^3.3.0",
    "@pinia/nuxt": "^0.11.2",
    "drizzle-orm": "^0.44.4",
    "nuxt": "^4.0.3",
    "pinia": "^3.0.3",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@iconify-json/heroicons": "^1.2.2",
    "@nuxt/eslint": "^1.8.0",
    "@nuxt/eslint-config": "^1.8.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.33.0",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0"
  }
}
