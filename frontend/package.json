{
  "name": "football-pitch-tactics",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port 8080 --no-fork --open",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "db:setup": "bun run db:migrate && bun run db:push && bun run db:seed",
    "db:migrate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run server/db/seed.ts",
    "calibrate": "bun run scripts/calibrate-match-engine.ts"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.123",
    "@iconify-json/simple-icons": "^1.2.93",
    "@libsql/client": "^0.17.4",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/ui": "^3.3.7",
    "@pinia/nuxt": "^0.11.3",
    "@types/canvas-confetti": "^1.9.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.5",
    "eslint-plugin-prettier": "^5.5.6",
    "nuxt": "^4.5.2",
    "pinia": "^3.0.4",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.10"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "canvas-confetti": "^1.9.4",
    "colord": "^2.9.3"
  }
}